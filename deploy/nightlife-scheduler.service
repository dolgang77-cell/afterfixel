# /etc/systemd/system/nightlife-scheduler.service
# Laravel 스케줄러 (cron 대체)
# 설치: sudo cp deploy/nightlife-scheduler.service /etc/systemd/system/
#        sudo cp deploy/nightlife-scheduler.timer   /etc/systemd/system/
#        sudo systemctl enable --now nightlife-scheduler.timer

[Unit]
Description=NITE Laravel Scheduler
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/nightlife

ExecStart=/usr/bin/php artisan schedule:run --no-interaction

StandardOutput=append:/var/log/nightlife/scheduler.log
StandardError=append:/var/log/nightlife/scheduler-error.log
