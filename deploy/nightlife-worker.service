# /etc/systemd/system/nightlife-worker.service
# 큐 워커: 백그라운드 작업 처리
# 설치: sudo cp deploy/nightlife-worker.service /etc/systemd/system/
#        sudo systemctl enable --now nightlife-worker

[Unit]
Description=NITE Queue Worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/nightlife

ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --max-time=3600 --memory=128

# 장애 시 자동 재시작 (5초 후)
Restart=always
RestartSec=5

# OOM 방지
MemoryMax=256M

# 로그
StandardOutput=append:/var/log/nightlife/worker.log
StandardError=append:/var/log/nightlife/worker-error.log

[Install]
WantedBy=multi-user.target
