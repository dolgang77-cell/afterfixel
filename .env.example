###############################################################################
# NITE - 서울 나이트라이프  |  환경변수 설정
# 복사: cp .env.example .env && php artisan key:generate
###############################################################################

#── 앱 기본 ──────────────────────────────────────────────────────────────────
APP_NAME=Nightlife
APP_ENV=production          # local | staging | production
APP_KEY=                    # php artisan key:generate 로 자동 생성
APP_DEBUG=false              # 운영에서는 반드시 false
APP_URL=https://nightlife.ive.co.kr
APP_TIMEZONE=Asia/Seoul

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

APP_MAINTENANCE_DRIVER=file

#── 데이터베이스 ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nightlife_db
DB_USERNAME=nightlife_user
DB_PASSWORD=                 # 운영 비밀번호 설정 필수

#── 캐시 / 세션 / 큐 ────────────────────────────────────────────────────────
CACHE_STORE=database         # database | redis | file
SESSION_DRIVER=database      # database | redis | file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database    # database | redis | sync
BROADCAST_CONNECTION=log

#── 위치 기반 근처 사용자 / 30분 만료 메시지 ────────────────────────────────
NEARBY_MESSAGING_ENABLED=false
NEARBY_LOCATION_TTL_MINUTES=10
NEARBY_MESSAGE_TTL_MINUTES=30
NEARBY_MAX_RADIUS_M=300
NEARBY_SAME_VENUE_TTL_MINUTES=180
NEARBY_LIST_LIMIT=40
NEARBY_MESSAGE_PREVIEW_LENGTH=80
NEARBY_NEW_CONVERSATION_LIMIT_PER_10M=3
NEARBY_MESSAGE_LIMIT_PER_MINUTE=5
NEARBY_MESSAGE_LIMIT_WINDOW_SECONDS=30

#── Redis (선택사항, 캐시/세션/큐에 redis 사용 시) ──────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#── 파일 스토리지 ────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public       # local | public | s3

#── 프로필 이미지 업로드 / 검수 ─────────────────────────────────────────────
PROFILE_IMAGE_DISK=local
PROFILE_IMAGE_BASE_DIR=uploads/profile
PROFILE_IMAGE_MAX_UPLOAD_KB=10240
PROFILE_IMAGE_MAX_DIMENSION=1024
PROFILE_IMAGE_THUMB_SIZE=200
PROFILE_IMAGE_QUALITY=82
PROFILE_IMAGE_STORE_ORIGINAL=false
PROFILE_IMAGE_MODERATION_PROVIDER=conservative   # conservative | google_vision
PROFILE_IMAGE_MODERATION_TIMEOUT=10
GOOGLE_VISION_API_KEY=
PROFILE_IMAGE_NSFW_ADULT_THRESHOLD=2
PROFILE_IMAGE_NSFW_RACY_THRESHOLD=3
PROFILE_IMAGE_NSFW_MEDICAL_THRESHOLD=3
PROFILE_IMAGE_NSFW_VIOLENCE_THRESHOLD=3

#── 로깅 ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily              # single(하나파일) | daily(일별 로테이션)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning            # debug | info | warning | error

#── 메일 (필요시) ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nightlife.ive.co.kr"
MAIL_FROM_NAME="${APP_NAME}"

#── 보안 ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

#── AWS S3 (선택사항) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
